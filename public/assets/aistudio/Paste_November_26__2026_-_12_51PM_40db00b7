+/****************************************************************************
+ * Name: ads7843e_filtered_value
+ ****************************************************************************/
+
+static uint16_t ads7843e_filtered_value(FAR struct ads7843e_dev_s *priv,
+                                        uint8_t cmd)
+{
+  uint16_t values[7];
+  uint16_t value;
+  int      i;
+  int      j;
+
+  for (i = 0; i < 7; i++)
+    {
+      values[i] = ads7843e_sendcmd(priv, cmd);
+    }
+
+  for (i = 1; i < 7; i++)
+    {
+      value = values[i];
+      for (j = i; j > 0 && values[j - 1] > value; j--)
+        {
+          values[j] = values[j - 1];
+        }
+
+      values[j] = value;
+    }
+
+  return ((uint32_t)values[2] + values[3] + values[4]) / 3;
+}
+
+/****************************************************************************
+ * Name: ads7843e_touch_resistance
+ ****************************************************************************/
+
+#define ADS7843E_MAX_TOUCH_RESISTANCE 3000
+
+static bool ads7843e_touch_resistance(uint16_t x, uint16_t z1, uint16_t z2,
+                                      uint16_t xplate_resistance,
+                                      uint16_t *resistance)
+{
+  uint64_t numerator;
+  uint64_t denominator;
+  uint64_t result;
+
+  if (xplate_resistance == 0 || z1 < 16 || z2 < z1)
+    {
+      return false;
+    }
+
+  numerator   = (uint64_t)x * xplate_resistance * (z2 - z1);
+  denominator = (uint64_t)4096 * z1;
+  result      = numerator / denominator;
+
+  if (result > ADS7843E_MAX_TOUCH_RESISTANCE)
+    {
+      return false;
+    }
+
+  *resistance = (uint16_t)result;
+  return true;
+}
