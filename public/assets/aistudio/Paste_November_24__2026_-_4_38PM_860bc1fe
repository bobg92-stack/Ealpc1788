1377: static int lpc17_40_ifup(struct net_driver_s *dev)
1378: {
1379:   struct lpc17_40_driver_s *priv =
1380:     (struct lpc17_40_driver_s *)dev->d_private;
1381:   uint32_t regval;
1382:   int ret;
1383:
1384:   ninfo("Bringing up: %u.%u.%u.%u\n",
1385:         ip4_addr1(dev->d_ipaddr), ip4_addr2(dev->d_ipaddr),
1386:         ip4_addr3(dev->d_ipaddr), ip4_addr4(dev->d_ipaddr));
1387:
1388:   /* Reset the Ethernet controller (again) */
1389:
1390:   lpc17_40_ethreset(priv);
1391:
1392:   /* Initialize the PHY and wait for the link to be established */
1393:
1394:   ret = lpc17_40_phyinit(priv);
1395:   if (ret != 0)
1396:     {
1397:       nerr("ERROR: lpc17_40_phyinit failed: %d\n", ret);
1398:       return ret;
1399:     }
1400:
1401:   /* Configure the MAC station address */
1402:
1403:   regval = (uint32_t)priv->lp_dev.d_mac.ether.ether_addr_octet[5] << 8 |
1404:            (uint32_t)priv->lp_dev.d_mac.ether.ether_addr_octet[4];
1405:   lpc17_40_putreg(regval, LPC17_40_ETH_SA0);
1406:
1407:   regval = (uint32_t)priv->lp_dev.d_mac.ether.ether_addr_octet[3] << 8 |
1408:            (uint32_t)priv->lp_dev.d_mac.ether.ether_addr_octet[2];
1409:   lpc17_40_putreg(regval, LPC17_40_ETH_SA1);
1410:
1411:   regval = (uint32_t)priv->lp_dev.d_mac.ether.ether_addr_octet[1] << 8 |
1412:            (uint32_t)priv->lp_dev.d_mac.ether.ether_addr_octet[0];
1413:   lpc17_40_putreg(regval, LPC17_40_ETH_SA2);
1414:
1415:   /* Initialize Ethernet interface for the PHY setup */
1416:
1417:   lpc17_40_macmode(priv->lp_mode);
1418:
1419:   /* Initialize EMAC DMA memory --
1420:    * descriptors, status, packet buffers, etc.
1421:    */
1422:
1423:   lpc17_40_txdescinit(priv);
1424:   lpc17_40_rxdescinit(priv);
1425:
1426:   /* Configure to pass all received frames */
1427:
1428:   regval = lpc17_40_getreg(LPC17_40_ETH_MAC1);
1429:   regval |= ETH_MAC1_PARF;
1430:   lpc17_40_putreg(regval, LPC17_40_ETH_MAC1);
1431:
1432:   /* Set up RX filter and configure to accept broadcast addresses, multicast
1433:    * addresses, and perfect station address matches.  We should also accept
1434:    * perfect matches and, most likely, broadcast (for example, for ARP
1435:    * requests).  Other RX filter options will only be enabled if so
1436:    * selected.  NOTE: There is a selection CONFIG_NET_BROADCAST, but this
1437:    * enables receipt of UDP broadcast packets inside of the stack.
1438:    */
1439:
1440:   regval = ETH_RXFLCTRL_PERFEN | ETH_RXFLCTRL_BCASTEN;
1441: #ifdef CONFIG_LPC17_40_MULTICAST
1442:   regval |= (ETH_RXFLCTRL_MCASTEN | ETH_RXFLCTRL_UCASTEN);
1443: #endif
1444: #ifdef CONFIG_LPC17_40_ETH_HASH
1445:   regval |= (ETH_RXFLCTRL_MCASTHASHEN | ETH_RXFLCTRL_UCASTHASHEN);
1446: #endif
1447:   lpc17_40_putreg(regval, LPC17_40_ETH_RXFLCTRL);
1448:
1449:   /* Clear any pending interrupts (shouldn't be any) */
1450:
1451:   lpc17_40_putreg(0xffffffff, LPC17_40_ETH_INTCLR);
1452:
1453:   /* Enable Ethernet interrupts.  The way we do this depends on whether or
1454:    * not Wakeup on Lan (WoL) has been configured.
1455:    */
1456:
1457: #ifdef CONFIG_LPC17_40_ETH_WOL
1458:   /* Configure WoL: Clear all receive filter WoLs and enable the perfect
1459:    * match WoL interrupt.  We will wait until the Wake-up to finish
1460:    * bringing things up.
1461:    */
1462:
1463:   lpc17_40_putreg(0xffffffff, LPC17_40_ETH_RXFLWOLCLR);
1464:   lpc17_40_putreg(ETH_RXFLCTRL_RXFILEN, LPC17_40_ETH_RXFLCTRL);
1465:
1466:   priv->lp_inten = ETH_INT_WKUP;
1467:   lpc17_40_putreg(ETH_INT_WKUP, LPC17_40_ETH_INTEN);
1468: #else
1469:   /* Otherwise, enable all Rx interrupts.  Tx interrupts, SOFTINT and WoL are
1470:    * excluded.  Tx interrupts will not be enabled until there is data to be
1471:    * sent.
1472:    */
1473:
1474:   priv->lp_inten = ETH_RXINTS;
1475:   lpc17_40_putreg(ETH_RXINTS, LPC17_40_ETH_INTEN);
1476: #endif
1477:
1478:   /* Enable Rx. "Enabling of the receive function is located in two places.
1479:    * The receive DMA manager needs to be enabled and the receive data path
1480:    * of the MAC needs to be enabled. To prevent overflow in the receive
1481:    * DMA engine the receive DMA engine should be enabled by setting the
1482:    * RxEnable bit in the Command register before enabling the receive data
1483:    * path in the MAC by setting the RECEIVE ENABLE bit in the MAC1 register."
1484:    */
1485:
1486:   regval  = lpc17_40_getreg(LPC17_40_ETH_CMD);
1487:   regval |= ETH_CMD_RXEN;
1488:   lpc17_40_putreg(regval, LPC17_40_ETH_CMD);
1489:
1490:   regval  = lpc17_40_getreg(LPC17_40_ETH_MAC1);
1491:   regval |= ETH_MAC1_RE;


