2133:
2134: #ifdef LPC17_40_HAVE_PHY
2135: static uint16_t lpc17_40_phyread(uint8_t phyaddr, uint8_t regaddr)
2136: {
2137:   uint32_t regval;
2138:
2139:   lpc17_40_putreg(1, LPC17_40_ETH_MCMD);
2140:
2141:   /* Set PHY address and PHY register address */
2142:
2143:   regval = ((uint32_t)phyaddr << ETH_MADR_PHYADDR_SHIFT) |
2144:            ((uint32_t)regaddr << ETH_MADR_REGADDR_SHIFT);
2145:   lpc17_40_putreg(regval, LPC17_40_ETH_MADR);
2146:
2147:   /* Set up to read */
2148:
2149:   lpc17_40_putreg(ETH_MCMD_READ, LPC17_40_ETH_MCMD);
2150:
2151:   /* Wait for the PHY command to complete */
2152:
2153:   while ((lpc17_40_getreg(LPC17_40_ETH_MIND) &
2154:          (ETH_MIND_BUSY | ETH_MIND_NVALID)) != 0);
2155:   lpc17_40_putreg(0, LPC17_40_ETH_MCMD);
2156:
2157:   /* Return the PHY register data */
2158:
2159:   return (uint16_t)(lpc17_40_getreg(LPC17_40_ETH_MRDD) & ETH_MRDD_MASK);
2160: }

2227:
2228: #if defined(LPC17_40_HAVE_PHY) && defined(CONFIG_LPC17_40_PHY_AUTONEG)
2229: static inline int lpc17_40_phyautoneg(uint8_t phyaddr)
2230: {
2231:   int32_t timeout;
2232:   uint16_t phyreg;
2233:
2234:   /* Start auto-negotiation */
2235:
2236:   lpc17_40_phywrite(phyaddr, MII_MCR, MII_MCR_ANENABLE | MII_MCR_ANRESTART);
2237:
2238:   /* Wait for autonegotiation to complete */
2239:
2240:   for (timeout = MII_BIG_TIMEOUT; timeout > 0; timeout--)
2241:     {
2242:       /* For some motive a large delay is necessary for some PHYs */
2243:
2244:       up_udelay(5000);
2245:
2246:       /* Check if auto-negotiation has completed */
2247:
2248:       phyreg = lpc17_40_phyread(phyaddr, MII_MSR);
2249:       if ((phyreg & MII_MSR_ANEGCOMPLETE) != 0)
2250:         {
2251:           /* Yes.. return success */
2252:
2253:           return OK;
2254:         }
2255:     }
2256:
2257:   nerr("ERROR: Auto-negotiation failed. MSR: %04x\n", phyreg);
2258:   return -ETIMEDOUT;
2259: }

2362:
2363: #ifdef LPC17_40_HAVE_PHY
2364: static inline int lpc17_40_phyinit(struct lpc17_40_driver_s *priv)
2365: {
2366:   unsigned int phyaddr;
2367:   uint16_t phyreg;
2368:   uint32_t regval;
2369:   int ret;
2370:
2371:   /* MII configuration: host clocked divided per board.h, no suppress
2372:    * preamble, no scan increment.
2373:    */
2374:
2375:   lpc17_40_putreg(ETH_MCFG_CLKSEL_DIV, LPC17_40_ETH_MCFG);
2376:   lpc17_40_putreg(0, LPC17_40_ETH_MCMD);
2377:
2378:   /* Enter RMII mode and select 100 MBPS support */
2379:
2380:   lpc17_40_putreg(ETH_CMD_RMII, LPC17_40_ETH_CMD);
2381:   lpc17_40_putreg(ETH_SUPP_SPEED, LPC17_40_ETH_SUPP);
2382:
2383:   /* Find PHY Address.  Because the controller has a pull-up and the
2384:    * PHY has pull-down resistors on RXD lines some times the PHY
2385:    * latches different at different addresses.
2386:    */
2387:
2388:   for (phyaddr = 0; phyaddr < 32; phyaddr++)
2389:     {
2390:       /* Check if we can see the selected device ID at this
2391:        * PHY address.
2392:        */
2393:
2394:       phyreg = (unsigned int)lpc17_40_phyread(phyaddr, MII_PHYID1);
2395:       ninfo("Addr: %d PHY ID1: %04x\n", phyaddr, phyreg);
2396:
2397:       /* Compare OUI bits 3-18 */
2398:
2399:       if (phyreg == LPC17_40_PHYID1)
2400:         {
2401:           phyreg = lpc17_40_phyread(phyaddr, MII_PHYID2);
2402:           ninfo("Addr: %d PHY ID2: %04x\n", phyaddr, phyreg);
2403:
2404:           /* Compare OUI bits 19-24 and the 6-bit model number (ignoring the
2405:            * 4-bit revision number).
2406:            */
2407:
2408:           if ((phyreg & 0xfff0) == (LPC17_40_PHYID2 & 0xfff0))
2409:             {
2410:               break;
2411:             }
2412:         }
2413:     }
2414:
2415:   /* Check if the PHY device address was found */
2416:
2417:   if (phyaddr > 31)
2418:     {
2419:       /* Failed to find PHY at any location */
2420:
2421:       nerr("ERROR: No PHY detected\n");
2422:       return -ENODEV;
2423:     }
2424:
2425:   ninfo("phyaddr: %d\n", phyaddr);
2426:
2427:   /* Save the discovered PHY device address */
2428:
2429:   priv->lp_phyaddr = phyaddr;
2430:
2431:   /* Reset the PHY */
2432:
2433:   ret = lpc17_40_phyreset(phyaddr);
2434:   if (ret < 0)
2435:     {
2436:       return ret;
2437:     }
2438:
2439:   lpc17_40_showmii(phyaddr, "After reset");
2440:
2441:   /* Check for preamble suppression support */
2442:
2443:   phyreg = lpc17_40_phyread(phyaddr, MII_MSR);
2444:   if ((phyreg & MII_MSR_MFRAMESUPPRESS) != 0)
2445:     {
2446:       /* The PHY supports preamble suppression */
2447:
2448:       regval  = lpc17_40_getreg(LPC17_40_ETH_MCFG);
2449:       regval |= ETH_MCFG_SUPPRE;
2450:       lpc17_40_putreg(regval, LPC17_40_ETH_MCFG);
2451:     }
2452:
2453: #if defined(CONFIG_ETH0_PHY_DP83848C)
2454:   /* Enable the RMII interface for DP83848x PHYs */
2455:
2456:   lpc17_40_phywrite(phyaddr, MII_DP83848C_RBR,
2457:                     MII_RBR_ELAST_2 | MII_RBR_RMIIMODE);
2458: #endif
2459:
2460:   /* Are we configured to do auto-negotiation? */
2461:
2462: #ifdef CONFIG_LPC17_40_PHY_AUTONEG
2463:   /* Enable FD mode, Auto-negotiation and 100Mbps speed */
2464:
2465:   lpc17_40_phywrite(phyaddr, MII_MCR,
2466:                     MII_MCR_FULLDPLX | MII_MCR_ANENABLE | MII_MCR_SPEED100);
2467:
2468:   /* Setup the Auto-negotiation advertisement: 100 or 10, and HD or FD */
2469:
2470:   lpc17_40_phywrite(phyaddr, MII_ADVERTISE,
2471:                  (MII_ADVERTISE_100BASETXFULL | MII_ADVERTISE_100BASETXHALF |
2472:                   MII_ADVERTISE_10BASETXFULL  | MII_ADVERTISE_10BASETXHALF  |
2473:                   MII_ADVERTISE_CSMA));
2474:
2475:   /* Then perform the auto-negotiation */
2476:
2477:   ret = lpc17_40_phyautoneg(phyaddr);
2478:   if (ret < 0)

