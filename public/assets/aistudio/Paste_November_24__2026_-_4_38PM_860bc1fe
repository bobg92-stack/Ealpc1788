4025:  ****************************************************************************/
4026:
4027: static int mmcsd_sdinitialize(FAR struct mmcsd_state_s *priv)
4028: {
4029:   uint32_t cid[4];
4030:   uint32_t scr[2];
4031:   int ret;
4032:
4033:   /* At this point, clocking has been supplied to the card, both CMD0 and
4034:    * ACMD41 (with OCR=0) have been sent successfully, the card is no longer
4035:    * busy and (presumably) in the IDLE state so there is good evidence
4036:    * that we have an SD card inserted into the slot.
4037:    *
4038:    * Send CMD2, ALL_SEND_CID.  The SD CMD2 is similar to the MMC CMD2 except
4039:    * that the buffer type used to transmit to response of the card (SD Memory
4040:    * Card: Push-Pull, MMC: Open-Drain). This implementation supports only a
4041:    * single SD card.  If multiple cards were installed in the slot, each card
4042:    * would respond to CMD2 by sending its CID (only one card completes the
4043:    * response at a time).  The driver should send CMD2 and obtain RCAs until
4044:    * no response to ALL_SEND_CID is received.
4045:    *
4046:    * When an SD card receives the CMD2 command it should transition to the
4047:    * identification state/card-identification mode
4048:    */
4049:
4050:   mmcsd_sendcmdpoll(priv, MMCSD_CMD2, 0);
4051:   ret = SDIO_RECVR2(priv->dev, MMCSD_CMD2, cid);
4052:   if (ret != OK)
4053:     {
4054:       ferr("ERROR: SDIO_RECVR2 for SD CID failed: %d\n", ret);
4055:       return ret;
4056:     }
4057:
4058:   mmcsd_decode_cid(priv, cid);
4059:
4060:   /* Send CMD3, SEND_RELATIVE_ADDR.  In both protocols, this command is used
4061:    * to assign a logical address to the card.  For MMC, the host assigns the
4062:    * address; for SD, the memory card has this responsibility. CMD3 causes
4063:    * transition to standby state/data-transfer mode
4064:    *
4065:    * Send CMD3 with argument 0, SD card publishes its RCA in the response.
4066:    */
4067:
4068:   mmcsd_sendcmdpoll(priv, SD_CMD3, 0);
4069:   ret = mmcsd_recv_r6(priv, SD_CMD3);
4070:   if (ret != OK)
4071:     {
4072:       ferr("ERROR: mmcsd_recv_r6 for SD RCA failed: %d\n", ret);
4073:       return ret;
4074:     }
4075:
4076:   finfo("RCA: %04x\n", priv->rca);
4077:
4078:   /* This should have caused a transition to standby state. However, this
4079:    * will not be reflected in the present R1/6 status.  R1/6 contains the
4080:    * state of the card when the command was received, not when it
4081:    * completed execution.
4082:    *
4083:    * Verify that we are in standby state/data-transfer mode
4084:    */
4085:
4086:   ret = mmcsd_verifystate(priv, MMCSD_R1_STATE_STBY);
4087:   if (ret != OK)
4088:     {
4089:       ferr("ERROR: Failed to enter standby state\n");
4090:       return ret;
4091:     }
4092:
4093:   /* Send CMD9, SEND_CSD, in standby state/data-transfer mode to obtain the
4094:    * Card Specific Data (CSD) register.  The argument is the RCA that we
4095:    * just obtained from CMD3.  The card stays in standby state/data-transfer
4096:    * mode.
4097:    */
4098:
4099:   mmcsd_sendcmdpoll(priv, MMCSD_CMD9, (uint32_t)priv->rca << 16);
4100:   ret = SDIO_RECVR2(priv->dev, MMCSD_CMD9, priv->csd);
4101:   if (ret != OK)
4102:     {
4103:       ferr("ERROR: Could not get SD CSD register(%d)\n", ret);
4104:       return ret;
4105:     }
4106:
4107:   mmcsd_decode_csd(priv, priv->csd);
4108:
4109:   /* Send CMD7 with the argument == RCA in order to select the card.
4110:    * Since we are supporting only a single card, we just leave the
4111:    * card selected all of the time.
4112:    */
4113:
4114:   mmcsd_sendcmdpoll(priv, MMCSD_CMD7S, (uint32_t)priv->rca << 16);
4115:   ret = mmcsd_recv_r1(priv, MMCSD_CMD7S);
4116:   if (ret != OK)
4117:     {
4118:       ferr("ERROR: mmcsd_recv_r1 for CMD7 failed: %d\n", ret);
4119:       return ret;
4120:     }
4121:
4122:   /* Set the Driver Stage Register (DSR) if (1) a CONFIG_MMCSD_DSR has been
4123:    * provided and (2) the card supports a DSR register.  If no DSR value
4124:    * the card default value (0x0404) will be used.
4125:    */
4126:
4127:   mmcsd_sendcmd4(priv);
4128:
4129:   /* Select high speed SD clocking (which may depend on the DSR setting) */
4130:
4131:   SDIO_CLOCK(priv->dev, CLOCK_SD_TRANSFER_1BIT);
4132:   MMCSD_USLEEP(MMCSD_CLK_DELAY);
4133:
4134:   /* If the hardware only supports 4-bit transfer mode then we forced to
4135:    * attempt to setup the card in this mode before checking the SCR register.
4136:    */
4137:
4138:   if ((priv->caps & SDIO_CAPS_4BIT_ONLY) != 0)
4139:     {
4140:       /* Select width (4-bit) bus operation */
4141:
4142:       priv->buswidth = MMCSD_SCR_BUSWIDTH_4BIT;
4143:       ret = mmcsd_widebus(priv);
4144:
4145:       if (ret != OK)
4146:         {

4765:  ****************************************************************************/
4766:
4767: static int mmcsd_hwinitialize(FAR struct mmcsd_state_s *priv)
4768: {
4769:   int ret;
4770:
4771:   ret = mmcsd_lock(priv);
4772:   if (ret < 0)
4773:     {
4774:       return ret;
4775:     }
4776:
4777:   /* Get the capabilities of the SDIO driver */
4778:
4779:   priv->caps = SDIO_CAPABILITIES(priv->dev);
4780:   finfo("DMA supported: %d\n", (priv->caps & SDIO_CAPS_DMASUPPORTED) != 0);
4781:
4782:   /* Attach and prepare MMC/SD interrupts */
4783:
4784:   if (SDIO_ATTACH(priv->dev))
4785:     {
4786:       ferr("ERROR: Unable to attach MMC/SD interrupts\n");
4787:       mmcsd_unlock(priv);
4788:       return -EBUSY;
4789:     }
4790:
4791:   finfo("Attached MMC/SD interrupts\n");
4792:
4793:   /* Register a callback so that we get informed if media is inserted or
4794:    * removed from the slot (Initially all callbacks are disabled).
4795:    */
4796:
4797: #if defined(CONFIG_SCHED_WORKQUEUE) && defined(CONFIG_SCHED_HPWORK)
4798:   SDIO_REGISTERCALLBACK(priv->dev, mmcsd_mediachange, (FAR void *)priv);
4799: #endif
4800:
4801:   /* Is there a card in the slot now? For an MMC/SD card, there are three
4802:    * possible card detect mechanisms:
4803:    *
4804:    *  1. Mechanical insertion that can be detected using the WP switch
4805:    *     that is closed when a card is inserted into then SD slot (SD
4806:    *     "hot insertion capable" card connector only)
4807:    *  2. Electrical insertion that can be sensed using the pull-up resistor
4808:    *     on CD/DAT3 (both SD/MMC),
4809:    *  3. Or by periodic attempts to initialize the card from software.
4810:    *
4811:    * The behavior of SDIO_PRESENT() is to use whatever information is
4812:    * available on the particular platform.  If no card insertion information
4813:    * is available (polling only), then SDIO_PRESENT() will always return
4814:    * true and we will try to initialize the card.
4815:    */
4816:
4817:   if (SDIO_PRESENT(priv->dev))
4818:     {
4819:       /* Yes... probe for a card in the slot */
4820:
4821:       ret = mmcsd_probe(priv);
4822:       if (ret != OK)
4823:         {
4824:           ferr("Slot not empty, but initialization failed: %d\n", ret);
4825:
4826:           /* NOTE: The failure to initialize a card does not mean that
4827:            * initialization has failed! A card could be installed in the slot
4828:            * at a later time. ENODEV is return in this case,
4829:            * sdio_slotinitialize will use this return value to set up the
4830:            * card inserted callback event.
4831:            */
4832:
4833:           ret = -ENODEV;
4834:         }
4835:     }
4836:   else
4837:     {
4838:       /* ENODEV is returned to indicate that no card is inserted in the slot.
4839:        * sdio_slotinitialize will use this return value to set up the card
4840:        * inserted callback event.
4841:        */
4842:
4843:       ret = -ENODEV;
4844:     }
4845:
4846:   /* OK is returned only if the slot initialized correctly AND the card in
4847:    * the slot was successfully configured.
4848:    */
4849:
4850:   mmcsd_unlock(priv);
4851:   return ret;
4852: }

4888:  ****************************************************************************/
4889:
4890: int mmcsd_slotinitialize(int minor, FAR struct sdio_dev_s *dev)
4891: {
4892:   FAR struct mmcsd_state_s *priv;
4893:   char devname[16];
4894:   int ret = -ENOMEM;
4895:
4896:   finfo("minor: %d\n", minor);
4897:
4898:   /* Sanity check */
4899:
4900: #ifdef CONFIG_DEBUG_FEATURES
4901:   if (minor < 0 || minor > 255 || !dev)
4902:     {
4903:       return -EINVAL;
4904:     }
4905: #endif
4906:
4907:   /* Allocate a MMC/SD state structure */
4908:
4909:   priv = (FAR struct mmcsd_state_s *)
4910:     kmm_malloc(sizeof(struct mmcsd_state_s));
4911:   if (priv == NULL)
4912:     {
4913:       return -ENOMEM;
4914:     }
4915:
4916:   /* Initialize the MMC/SD state structure */
4917:
4918:   memset(priv, 0, sizeof(struct mmcsd_state_s));
4919:   nxmutex_init(&priv->lock);
4920:
4921:   /* Bind the MMCSD driver to the MMCSD state structure */
4922:
4923:   priv->dev = dev;
4924:   priv->minor = minor;
4925:
4926:   /* Initialize the hardware associated with the slot */
4927:
4928:   ret = mmcsd_hwinitialize(priv);
4929:
4930:   /* Was the slot initialized successfully? */
4931:
4932:   if (ret != OK)
4933:     {
4934:       /* No... But the error ENODEV is returned if hardware
4935:        * initialization succeeded but no card is inserted in the slot.
4936:        * In this case, the no error occurred, but the driver is still
4937:        * not ready.
4938:        */
4939:
4940:       if (ret == -ENODEV)
4941:         {
4942:           /* No card in the slot (or if there is, we could not recognize
4943:            * it).. Setup to receive the media inserted event
4944:            */
4945:
4946:           SDIO_CALLBACKENABLE(priv->dev, SDIOMEDIA_INSERTED);
4947:
4948:           finfo("MMC/SD slot is empty\n");
4949:         }
4950:       else
4951:         {
4952:           /* Some other non-recoverable bad thing happened */
4953:
4954:           ferr("ERROR: Failed to initialize MMC/SD slot: %d\n", ret);
4955:           goto errout_with_alloc;
4956:         }
4957:     }
4958:
4959: #ifdef CONFIG_MMCSD_PROCFS
4960:   mmcsd_initialize_procfs();
4961: #endif
4962:
4963:   /* Create a MMCSD device name */
4964:
4965:   snprintf(devname, sizeof(devname), "/dev/mmcsd%d", minor);
4966:
4967:   finfo("MMC: %s %" PRIu64 "KB %s %s mode\n", devname,
4968:          ((uint64_t)priv->part[0].nblocks << priv->blockshift) >> 10,
4969:          priv->widebus ? "4-bits" : "1-bit",
4970:          mmc_get_mode_name(priv->mode));
4971:
4972:   return OK;
4973:
4974: errout_with_alloc:
4975:   nxmutex_destroy(&priv->lock);
4976:   kmm_free(priv);
4977:   return ret;
4978: }


