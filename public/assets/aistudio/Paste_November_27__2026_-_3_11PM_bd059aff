   174
   175  void CWindowMessenger::inputWorkCallback(FAR void *arg)
   176  {
   177    work_state_t *state = (work_state_t*)arg;
   178    printf("NX worker begin: state=%p press=%d release=%d held=%d pressAt=(%d,%d) releaseAt=(%d,%d)\n",
   179           state,
   180           state->windowMessenger->m_xyinput.leftPressed,
   181           state->windowMessenger->m_xyinput.leftReleased,
   182           state->windowMessenger->m_xyinput.leftHeld,
   183           state->windowMessenger->m_xyinput.pressX,
   184           state->windowMessenger->m_xyinput.pressY,
   185           state->windowMessenger->m_xyinput.releaseX,
   186           state->windowMessenger->m_xyinput.releaseY);
   187    bool handled = state->windowMessenger->pollEvents();
   188    printf("NX worker end: state=%p handled=%d\n", state, handled);
   189    delete state;
   190  }
   191
   192  void CWindowMessenger::destroyWorkCallback(FAR void *arg)
   193  {
   194    work_state_t *state = (work_state_t*)arg;
   195
   196    // First make sure any pending input events have been handled.
   197
   198    state->windowMessenger->pollEvents();
   199
   200    // Then release the memory.
   201
   202    ginfo("Deleting app=%p\n", state->instance);
   203    IApplication *app = (IApplication *)state->instance;
   204    delete app;
   205    delete state;
