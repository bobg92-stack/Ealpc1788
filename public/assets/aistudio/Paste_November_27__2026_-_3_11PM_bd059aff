    77  /**
    78   * Handle an NX window mouse input event.
    79   */
    80
    81  void CWindowMessenger::handleMouseEvent(FAR const struct nxgl_point_s *pos,
    82                                          uint8_t buttons)
    83  {
    84    printf("NX callback: local=(%d,%d) buttons=%02x\n",
    85           pos->x, pos->y, buttons);
    86
    87    // The logic path here is tortuous but flexible:
    88    //
    89    //  1. A listener thread receives mouse or touchscreen input and injects
    90    //     that into NX via nx_mousein
    91    //  2. In the multi-user mode, this will send a message to the NX server
    92    //  3. The NX server will determine which window gets the mouse input
    93    //     and send a window event message to the NX listener thread.
    94    //  4. The NX listener thread receives a windows event.  The NX listener thread
    95    //     is part of CTaskBar and was created when NX server connection was
    96    //     established.  This event may be a positional change notification, a
    97    //     redraw request, or mouse or keyboard input.  In this case, mouse input.
    98    //  5. The NX listener thread handles the message by calling nx_eventhandler().
    99    //     nx_eventhandler() dispatches the message by calling a method in the
   100    //     NXWidgets::CCallback instance associated with the window.
   101    //     NXWidgets::CCallback is a part of the CWidgetControl.
   102    //  6. NXWidgets::CCallback calls into NXWidgets::CWidgetControl to process
   103    //     the event.
   104    //  7. NXWidgets::CWidgetControl records the new state data and raises a
   105    //     window event.
   106    //  8. NXWidgets::CWindowEventHandlerList will give the event to this method
   107    //     NxWM::CWindowMessenger.
   108    //  9. This NxWM::CWindowMessenger method will schedule an entry on the work
   109    //     queue.
   110    // 10. The work queue callback will finally call pollEvents() to execute whatever
   111    //     actions the input event should trigger.
   112
   113    work_state_t *state = new work_state_t;
   114    state->windowMessenger = this;
   115    int ret = work_queue(USRWORK, &state->work, &inputWorkCallback, state, 0);
   116    printf("NX queue: state=%p result=%d at=(%d,%d) buttons=%02x\n",
   117           state, ret, pos->x, pos->y, buttons);
   118    if (ret < 0)
   119      {
   120        gerr("ERROR: work_queue failed: %d\n", ret);
   121        delete state;
   122      }
   123  }
