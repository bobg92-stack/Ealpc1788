   160    // Send a message to destroy the window instance.
   161
   162    work_state_t *state = new work_state_t;
   163    state->windowMessenger = this;
   164    state->instance = arg;
   165
   166    int ret = work_queue(USRWORK, &state->work, &destroyWorkCallback, state, 0);
   167    if (ret < 0)
   168      {
   169        gerr("ERROR: work_queue failed: %d\n", ret);
   170      }
   171  }
